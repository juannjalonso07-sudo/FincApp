# Copiá a .env.local y completá con los datos de tu proyecto de Supabase (Settings > API).
# Sin estos valores la app funciona en "modo local" (solo este equipo, sin nube ni cuentas).
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
# Precio del plan Pro que se muestra (el que se cobra lo define PRO_PRICE_ARS en la Edge Function)
VITE_PRO_PRICE_ARS=
# Datos legales que aparecen en Términos y Privacidad
VITE_CONTACT_EMAIL=
VITE_LEGAL_NAME=
VITE_LEGAL_CUIT=
