{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FincApp",
  "version": "1.0.0",
  "identifier": "app.fincapp.desktop",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://localhost:5173", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": {
    "windows": [{ "label": "main", "title": "FincApp", "width": 1280, "height": 820, "minWidth": 900, "minHeight": 600 }],
    "security": { "csp": "default-src 'self'; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://api.open-meteo.com https://es.wikipedia.org; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline'; script-src 'self'; worker-src 'self' blob:" }
  },
  "bundle": {
    "active": true, "targets": ["nsis"], "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "shortDescription": "Cuaderno de campo para productores",
    "windows": { "nsis": { "languages": ["Spanish"], "installMode": "currentUser" } }
  }
}
